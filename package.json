{
  "name": "ashyq-bilim",
  "packageManager": "pnpm@10.23.0",
  "private": true,
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.6",
      "@types/react-dom": "19.2.3"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,css,json}\"",
    "lint": "turbo run lint",
    "oxlint": "oxlint --type-aware --fix --fix-suggestions --fix-dangerously",
    "start": "turbo run start"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "oxlint": "^1.30.0",
    "oxlint-tsgolint": "^0.8.2",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sort-imports": "^1.8.8",
    "prettier-plugin-sort-json": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.6.1"
  }
}
