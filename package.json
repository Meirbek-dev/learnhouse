{
  "name": "ashyq-bilim",
  "packageManager": "pnpm@10.20.0",
  "private": true,
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,css,json}\"",
    "lint": "turbo run lint",
    "oxlint": "oxlint --fix --fix-suggestions",
    "start": "turbo run start"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "oxlint": "^1.26.0",
    "oxlint-tsgolint": "^0.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sort-imports": "^1.8.8",
    "prettier-plugin-sort-json": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.6.0"
  }
}
