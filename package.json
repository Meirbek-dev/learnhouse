{
  "name": "openu",
  "packageManager": "pnpm@10.14.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,css,json}\"",
    "fresh-install": "rm -rf node_modules apps/web/node_modules && pnpm install",
    "lint": "turbo run lint",
    "oxlint": "oxlint --fix --fix-suggestions",
    "start": "turbo run start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "eslint": "^9.32.0",
    "oxlint": "^1.9.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "prettier-plugin-sort-imports": "^1.8.8",
    "prettier-plugin-sort-json": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.5.5"
  }
}
