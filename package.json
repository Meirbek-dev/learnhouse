{
  "name": "openu",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "start": "turbo run start",
    "start-standalone": "node ./apps/web/.next/standalone/apps/web/server.js",
    "postbuild": "xcopy .\\.next\\static .\\.next\\standalone\\.next\\static /E /I /Y || cp -r ./.next/static ./.next/standalone/.next/static",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "oxlint": "oxlint --fix --fix-suggestions",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,css}\"",
    "fresh-install": "rm -rf node_modules apps/web/node_modules && pnpm install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "eslint": "^9.30.0",
    "oxlint": "^1.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
