{
  "name": "ashyq-bilim",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:all": "mprocs",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,css,json}\"",
    "lint": "turbo run lint",
    "oxlint": "oxlint --type-aware --fix --fix-suggestions --fix-dangerously",
    "start": "turbo run start",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "mprocs": "^0.8.3",
    "oxlint": "^1.43.0",
    "oxlint-tsgolint": "^0.11.5",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sort-imports": "^1.8.10",
    "prettier-plugin-sort-json": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.3"
  },
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.3.8"
  }
}
