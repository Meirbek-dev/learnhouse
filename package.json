{
  "name": "openu",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "start": "turbo run start",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "oxlint": "oxlint --fix --fix-suggestions",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,css}\"",
    "fresh-install": "rm -rf node_modules apps/web/node_modules && pnpm install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.1",
    "eslint": "^9.30.1",
    "oxlint": "^1.6.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.8",
      "@types/react-dom": "19.1.6"
    }
  }
}
