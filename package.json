{
  "name": "ashyq-bilim",
  "packageManager": "pnpm@10.28.2",
  "private": true,
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.10",
      "@types/react-dom": "19.2.3"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "core-js",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:all": "mprocs",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,css,json}\"",
    "lint": "turbo run lint",
    "oxlint": "oxlint --type-aware --fix --fix-suggestions --fix-dangerously",
    "start": "turbo run start"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "mprocs": "^0.8.3",
    "oxlint": "^1.42.0",
    "oxlint-tsgolint": "^0.11.2",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sort-imports": "^1.8.9",
    "prettier-plugin-sort-json": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.7.6"
  }
}
