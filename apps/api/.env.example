PLATFORM_SITE_NAME="Ashyq Bilim"
PLATFORM_SITE_DESCRIPTION="МООК Платформа Ashyq Bilim."
PLATFORM_CONTACT_EMAIL=contact@cs-mooc.tou.edu.kz

# general
PLATFORM_DEVELOPMENT_MODE=True

# security
PLATFORM_AUTH_JWT_SECRET_KEY="secret"

# hosting config
PLATFORM_DOMAIN=https://cs-mooc.tou.edu.kz/
PLATFORM_SSL=True
PLATFORM_PORT=1338
PLATFORM_USE_DEFAULT_ORG=False
PLATFORM_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
PLATFORM_COOKIE_DOMAIN=.localhost
PLATFORM_ALLOWED_REGEXP=\b((?:https?://)[^\s/$.?#].[^\s]*)\b
PLATFORM_SELF_HOSTED=True
PLATFORM_SQL_CONNECTION_STRING=postgresql+psycopg://openu:openu@localhost:5432/openu
PLATFORM_REDIS_CONNECTION_STRING=redis://localhost:6379/openu

PLATFORM_CONTENT_DELIVERY_TYPE=filesystem # "filesystem" or "s3api"
PLATFORM_S3_API_BUCKET_NAME=""
PLATFORM_S3_API_ENDPOINT_URL=""

# AI
PLATFORM_OPENAI_API_KEY=""
PLATFORM_IS_AI_ENABLED=True

# chromadb
PLATFORM_CHROMADB_SEPARATE=True
PLATFORM_CHROMADB_HOST=localhost

# Mailing config
PLATFORM_RESEND_API_KEY=""
PLATFORM_SYSTEM_EMAIL_ADDRESS="contact@cs-mooc.tou.edu.kz"

# stripe
PLATFORM_STRIPE_SECRET_KEY=""
PLATFORM_STRIPE_PUBLISHABLE_KEY=""
PLATFORM_STRIPE_WEBHOOK_STANDARD_SECRET=""
PLATFORM_STRIPE_WEBHOOK_CONNECT_SECRET=""
PLATFORM_STRIPE_CLIENT_ID=""

PLATFORM_LOGFIRE_ENABLED=false

CLOUD_INTERNAL_KEY=""

