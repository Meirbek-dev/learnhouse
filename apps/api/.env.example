OPENU_SITE_NAME="OpenU"
OPENU_SITE_DESCRIPTION="OpenU is an open-source platform tailored for learning experiences."
OPENU_CONTACT_EMAIL=hi@openu.app

# general
OPENU_DEVELOPMENT_MODE=true
OPENU_INSTALL_MODE=true

# security
OPENU_AUTH_JWT_SECRET_KEY="secret"

# hosting config
OPENU_DOMAIN=openu.tou.edu.kz
OPENU_SSL=true
OPENU_PORT=1338
OPENU_USE_DEFAULT_ORG=true
OPENU_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
OPENU_COOKIE_DOMAIN=.localhost
OPENU_ALLOWED_REGEXP=\b((?:https?://)[^\s/$.?#].[^\s]*)\b
OPENU_SELF_HOSTED=false
OPENU_SQL_CONNECTION_STRING=postgresql+psycopg2://openu:openu@localhost:5432/openu
OPENU_REDIS_CONNECTION_STRING=redis://localhost:6379/openu

OPENU_CONTENT_DELIVERY_TYPE="filesystem" # "filesystem" or "s3api"
OPENU_S3_API_BUCKET_NAME=""
OPENU_S3_API_ENDPOINT_URL=""

# AI
OPENU_OPENAI_API_KEY=""
OPENU_IS_AI_ENABLED=""

# chromadb
OPENU_CHROMADB_SEPARATE=true
OPENU_CHROMADB_HOST=localhost

# Mailing config
OPENU_RESEND_API_KEY=""
OPENU_SYSTEM_EMAIL_ADDRESS=""

# stripe
OPENU_STRIPE_SECRET_KEY=""
OPENU_STRIPE_PUBLISHABLE_KEY=""
OPENU_STRIPE_WEBHOOK_STANDARD_SECRET=""
OPENU_STRIPE_WEBHOOK_CONNECT_SECRET=""
OPENU_STRIPE_CLIENT_ID=""


CLOUD_INTERNAL_KEY=""
